[node name="Label2" type="Label" parent="VBoxContainer" unique_id=82401514]
custom_minimum_size = Vector2(1100, 0)
layout_mode = 2
text = "Each alien in the roster has two abilities: a default and an ultimate. As the name might imply, the default can be used more often. After every use, you have a short cooldown, the length of which varies between aliens. Ultimates, on the other hand, can only be used after a charge bar fills up. This usualy takes a long time, but it pays off with a powerful effect. At the bottom of the screen, under each player, you can see how much longer until a cooldown finishes or a charge fills up. The bar turns green when useable and is red otherwise "
label_settings = SubResource("LabelSettings_3hqcg")
