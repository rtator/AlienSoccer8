[node name="Label2" type="Label" parent="Control/HBoxContainer/VBoxContainer"]
layout_mode = 2
text = "Scaler is the tank of the game, being one of if not the slowest alien to hit the field. Don't let that fool you, though, because Scaler is one of the best defensive options available. It's naturally larger, and has two defensive abilities that both greatly increase Scaler's chances of returning the ball, either by making the ball or itself larger. 

Default - Enlarge
Cooldown: 200
Duration: 200
Scaler makes the ball expand in size temporarily.

Ultimate - Bulking Phase
Charge: 600
Duration: 300
Scaler grows enormously and slowly shrinks back down to normal after.
"
label_settings = SubResource("LabelSettings_l5h64")
autowrap_mode = 2

