[node name="Label2" type="Label" parent="Control/HBoxContainer/VBoxContainer" unique_id=1768697848]
layout_mode = 2
text = "Speedy is an alien built for high skill and little mistakes. Despite its small size, Speedy is very good at both defense and offense due to having the single highest speed stat in the game, outclassing every other alien in speed. However, Speedy is also very slippery, and can be hard to control at times, making it a difficult alien to both play and master.

Default - Dash
Cooldown: 200
Duration: 10
Speedy dashes forwards, hitting the ball along its dash if possible.

Ultimate - Accelerated Motors
Charge: 500
Duration: 200
Speedy gains a small speed boost and its friction is increased drastically, giving it much more control and power.
"
label_settings = SubResource("LabelSettings_x55oy")
autowrap_mode = 2
